      "motion": ["level", "climb", "descent", "acceleration", "turn", "stop_start_if_applicable"],
      "timing": ["jitter", "clock_offset", "bounded_drift", "burst_delay", "reordering"],
      "identity": ["known_stable_identity", "address_collision", "address_change", "anonymous_later_profile_only"],
      "load": ["nominal", "burst", "capacity_boundary", "overload", "recovery"]
