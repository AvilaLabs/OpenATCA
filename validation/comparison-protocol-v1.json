  "scorecard": {
    "metrics": [
      "horizontal_position_rms_m",
      "horizontal_position_absolute_error_p99_m",
      "velocity_error",
      "update_interval_and_coverage",
      "valid_coast_missing_fraction",
      "receive_to_usable_latency_p50_p95_p99",
      "throughput_at_declared_quality_and_resource_envelope",
      "peak_memory_and_cpu",
      "input_terminal_disposition_counts",
      "output_completeness_and_validity"
    ],
    "report_distributions": ["pooled", "per_flight", "per_scenario"],
    "competitive_relative_goals": {
      "position_rms_ratio_max": 0.70,
      "p99_position_error_ratio_max": 0.80,
      "p99_receive_to_usable_latency_ratio_max": 0.50,
      "throughput_ratio_min": 2.0,
      "same_quality_required": true,
      "same_resource_envelope_required": true,
      "goals_are_universal_physical_guarantees": false,
      "confidence_interval_must_support_direction": true
    },
    "normative_floor": {
      "standard": "EUROCONTROL ESASSP 1.3 Recommended",
      "source": "docs/BENCHMARKS.md",
      "lowering_or_replacing_by_relative_goal": false
    }
  },
  "strict_gates": {
    "every_measurement_exactly_one_terminal_disposition": true,
    "every_required_truth_grid_point_exactly_one_output_status": true,
    "unaccounted_input_or_output_loss_allowed": 0,
    "missing_rows_scored_not_omitted": true,
    "explicit_policy_rejection_counted": true,
    "tracking_regressions_in_predeclared_scenario_or_flight_guardrails_allowed": 0,
    "accuracy_or_speed_can_offset_integrity_failure": false
  },
  "statistics_and_exclusions": {
    "paired_by": ["scenario_id", "flight_id"],
    "confidence_interval": "hierarchical_cluster_bootstrap_scenarios_then_flights_within_scenario",
    "paired_observations_retained": true,
    "seed_as_independent_aircraft_or_physical_reference": false,
    "report": ["method", "replicates", "point_estimate", "interval", "cluster_and_observation_counts", "truth_uncertainty", "clock_uncertainty"],
    "publish_uncertain_truth_outlier_malformed_excluded_unmatched_and_reason_counts": true,
    "eligibility_frozen_before_candidate_results": true,
    "eligibility_identical_for_all_systems": true,
    "primary_result_includes_all_eligible_observations": true,
    "robust_or_trimmed_result": "secondary_and_shown_with_untrimmed_result",
    "posthoc_exclusion_based_on_candidate_error_or_system_identity": false,
    "empty_denominator": "n=0_no_estimate_not_zero"
  },
