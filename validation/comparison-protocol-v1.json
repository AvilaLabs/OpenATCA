{
  "protocol_id": "openatca-comparison",
  "version": "1.0.3",
  "status": "draft_prequalification_clarification",
  "normative_document": "docs/COMPARISON_PROTOCOL.md",
  "frozen_at": "2026-11-18",
  "correction_record": {
    "supersedes_version": "1.0.0",
    "supersedes_commit": "71d380699a47937d433f6b6849da231512b20390",
    "defect": "development default seed 1 overlapped qualification seed IDs 0 through 99",
    "qualification_measurements_started": false,
    "status": "draft_correction_to_initial_contract",
    "prequalification_clarification": "v1.0.3 freezes initialization, post-initialization scoring, diagnostic-only dropout handling, and a separate blocking dropout fault cohort before qualification data are opened"
  },
  "claim_scope": {
    "initial_cohort": "adsb_kinematic_v1",
    "supports": [
      "paired_position_and_velocity_comparison",
      "explicit_update_coast_missing_scoring",
      "controlled_receive_to_usable_latency",
      "controlled_throughput_at_declared_quality_and_resources"
    ],
    "not_established": [
      "anonymous_multisensor_association",
      "radar_fusion",
      "full_nas_capacity",
      "live_feed_latency",
      "operational_suitability"
    ],
    "stage_claims": {
      "development_control": ["development_only_comparison"],
      "professional_tracker": ["qualified_component_relative_comparison"],
      "legacy_export": ["exported_output_comparison_only"],
      "controlled_legacy": ["controlled_model_comparison_only"]
    },
    "named_legacy_claim_requires": [
      "authenticated_permitted_export_or_input_set",
      "documented_scoring_scope",
      "same_inputs_truth_evaluator_and_resource_envelope"
    ]
  },
  "profile": {
    "id": "adsb_kinematic_v1",
    "status": "controlled_component_profile",
    "origin_ns": "declared_in_run_manifest",
    "duration_s": "declared_in_run_manifest",
    "score_grid": "declared_in_run_manifest",
    "external_reference_stage": "unknown_until_a_qualified_artifact_and_approved_run_are_recorded"
  },
  "initialization_and_qualification": {
    "score_origin": "scenario_manifest.grid_start_ns",
    "candidate_initialization": {
      "scheme": "M_of_N_distinct_input_reports",
      "m": 2,
      "n": 3,
      "distinct_report_key": "event_id"
    },
    "development_control_initialization": {
      "minimum_distinct_input_reports_before_state_is_usable": 2,
      "distinct_report_key": "event_id"
    },
    "coast_when_actual_source_age_ns_greater_than": 2000000000,
    "post_initialization_window": {
      "start_ns": "scenario_manifest.grid_start_ns + 2000000000",
      "exclude_before_start_from_postinit_metrics_only": true,
      "retain_cold_start_metrics": true,
      "retain_all_grid_metrics": true
    },
    "usable_statuses": ["valid"],
    "paired_postinit_scoring": {
      "key": ["scenario_id", "flight_id", "score_ns"],
      "candidate_and_baseline_usable_keysets_must_match_for_accuracy_qualification": true,
      "mismatch_blocks_qualified_accuracy": true,
      "retain_raw_per_system_metrics_on_mismatch": true,
      "report_keyset_intersection_and_difference_counts": true
    },
    "nominal_scenarios": {
      "straight": {"role": "qualification", "postinit_usable_ratio_min": 0.999, "candidate_ratio_at_least_baseline": true},
      "turn": {"role": "qualification", "postinit_usable_ratio_min": 0.999, "candidate_ratio_at_least_baseline": true},
      "acceleration": {"role": "qualification", "postinit_usable_ratio_min": 0.999, "candidate_ratio_at_least_baseline": true},
      "crossing": {"role": "qualification", "postinit_usable_ratio_min": 0.999, "candidate_ratio_at_least_baseline": true},
      "delayed": {"role": "qualification", "postinit_usable_ratio_min": 0.999, "candidate_ratio_at_least_baseline": true}
    },
    "diagnostic_scenarios": {
      "dropout": {
        "role": "diagnostic_only",
        "qualification_gate_in_v1": false,
        "reason": "four scheduled source absences per twelve seconds imply two coast grid points per twelve seconds under the frozen two-second coast rule; 0.999 usable coverage is not attainable",
        "never_reclassify_after_observing_candidate": true
      }
    }
  },
  "baseline_status": {
    "professional_tracker": "unknown_no_qualified_artifact_or_approved_run",
    "legacy_export": "unknown_no_authenticated_permitted_export",
    "python_or_controlled_legacy_may_be_labeled_as_professional": false
  },
  "csv": {
    "encoding": "UTF-8",
    "delimiter": ",",
    "headers_exact": true,
    "timestamp_unit": "integer_nanoseconds",
    "truth": [
      "scenario_id", "flight_id", "time_ns", "lat_deg", "lon_deg",
      "ve_mps", "vn_mps", "phase"
    ],
    "measurements": [
      "event_id", "scenario_id", "flight_id", "sensor_id", "sensor_ns",
      "receive_ns", "lat_deg", "lon_deg", "ve_mps", "vn_mps",
      "sigma_pos_m", "sigma_vel_mps"
    ],
    "outputs": [
      "scenario_id", "flight_id", "score_ns", "source_ns", "publish_ns",
      "lat_deg", "lon_deg", "ve_mps", "vn_mps", "status"
    ],
    "output_status_enum": ["valid", "coast", "missing"],
    "missing_output_row": {
      "score_ns_equals_publish_ns": true,
      "source_ns": "empty",
      "state_fields_empty": ["lat_deg", "lon_deg", "ve_mps", "vn_mps"],
      "row_required_for_each_missing_grid_point": true
    },
    "identity_source": "scenario_manifest_not_candidate_output",
    "invalid_or_duplicate_row_policy": "count_and_fail_strict_gate_unless_profile_declares_disposition"
  },
  "run_ledger": {
    "frozen_before_execution": true,
    "input_ledger_key": "event_id",
    "input_terminal_dispositions": ["applied", "held", "rejected_policy", "expired", "duplicate", "malformed", "unprocessed"],
    "output_ledger_key": ["scenario_id", "flight_id", "score_ns"],
    "output_required_statuses": ["valid", "coast", "missing"],
    "required_counts": ["expected", "observed", "matched", "unmatched", "duplicate", "malformed", "excluded_by_reason"],
    "unprocessed_or_unaccounted_allowed": 0,
    "ledger_hashes_required": true
  },
  "references": {
    "qualification_required_before_scoring": true,
    "required_evidence": [
      "provenance_and_rights",
      "identity_and_leg_continuity_independent_of_candidate",
      "coverage_and_uncertainty_against_frozen_limits",
      "counts_and_reasons_for_rejected_truth_samples"
    ],
    "simulation_truth": "latent_scenario_state_with_independent_keyed_measurement_noise",
    "physical_reference": [
      "documented_calibration",
      "common_clock_alignment_and_uncertainty",
      "uncertainty_budget",
      "independent_verification"
    ],
    "rtk_current_status": "not_qualified_as_independent_reference",
    "adsb_correlated_truth_warning": "ADS-B-derived truth against ADS-B-fed output is not independent absolute accuracy"
  },
