    "physical_elapsed_cost_clock": "monotonic_clock_separate_from_scenario_time",
    "receive_ns_clock_domain": "calibrated_common_monotonic_scenario_axis_for_latency_profiles",
    "sensor_ns_clock_domain": "sensor_clock_with_frozen_calibration_to_common_axis",
    "receive_to_usable_latency": "receive_ns_to_first_valid_published_output_causally_incorporating_event",
    "unusable_event": "count_terminal_disposition_no_latency_completion",
    "clock_calibration": "independent_frozen_common_correction_and_uncertainty",
    "candidate_lag_refit_away": false,
    "replay_cost_is_live_latency": false
