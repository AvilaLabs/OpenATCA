{
  "schema_version": 1,
  "entries": [
    {
      "path": "tools/test_kani_validation.py",
      "rule": "a",
      "use": {
        "kind": "ci",
        "file": ".github/workflows/rust-proofs.yml",
        "needle": "python3 tools/test_kani_validation.py"
      }
    },
    {
      "path": "tools/check_proof_caps.py",
