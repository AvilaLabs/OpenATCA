{
  "format_id": "openatca-oag2adpt-manifest-v1-v3",
  "spec_version": 1,
  "implementation": "../../../tools/oa-adapt/src/manifest.rs",
  "encoding": "binary; integers little-endian; digests raw 32-byte SHA-256; text is UTF-8 with byte lengths",
  "grammar_ebnf": [
    "manifest = common-header, version-tail, common-text, issue-text?;",
    "common-header = magic[8], schema:u16le, reader-min:u16le, reader-max:u16le, release-len:u8, facility-len:u8, change-ref-len:u8, component-count:u8, snapshot-len:u64le, snapshot-sha256[32];",
    "v1-tail = empty;",
    "v2-tail = adaptation-version:u64le, previous-manifest-sha256[32], change-class:u8, issuer-len:u8, approver-len:u8, reason-len:u16le;",
    "v3-tail = v2-tail, ca-preset-len:u64le, ca-preset-sha256[32];",
    "common-text = release[release-len], facility[facility-len], change-ref[change-ref-len];",
    "issue-text = issuer[issuer-len], approver[approver-len], reason[reason-len];",
    "magic = %x4F.41.47.32.41.44.50.54;"
  ],
  "common_header_fields": [
    {"offset": 0, "width": 8, "field": "magic", "value_ascii": "OAG2ADPT"},
    {"offset": 8, "width": 2, "field": "schema_version", "type": "u16le", "values": {"1": "legacy snapshot package", "2": "issued snapshot package", "3": "issued snapshot plus CA preset"}},
    {"offset": 10, "width": 2, "field": "reader_min", "type": "u16le"},
    {"offset": 12, "width": 2, "field": "reader_max", "type": "u16le"},
    {"offset": 14, "width": 1, "field": "release_len", "type": "u8", "max": 64},
    {"offset": 15, "width": 1, "field": "facility_len", "type": "u8", "max": 64},
    {"offset": 16, "width": 1, "field": "change_ref_len", "type": "u8", "max": 128},
    {"offset": 17, "width": 1, "field": "component_count", "type": "u8", "versions": {"1": 1, "2": 1, "3": 2}},
    {"offset": 18, "width": 8, "field": "snapshot_len", "type": "u64le", "maximum": "oa_airspace::snapshot::MAX_SNAPSHOT_BYTES"},
    {"offset": 26, "width": 32, "field": "snapshot_sha256", "type": "raw_sha256"}
  ],
  "versions": {
    "1": {
      "fixed_header_bytes": 58,
      "tail": [],
      "variable_text_offset": 58,
      "variable_text_order": ["release", "facility", "change_ref"],
      "components": ["airspace.snapshot"]
    },
    "2": {
      "fixed_header_bytes": 103,
      "issue_header_offset": 58,
      "issue_header_fields": [
        {"offset": 58, "width": 8, "field": "adaptation_version", "type": "u64le", "minimum": 1},
        {"offset": 66, "width": 32, "field": "previous_manifest_sha256", "type": "raw_sha256"},
        {"offset": 98, "width": 1, "field": "change_class", "type": "u8", "values": {"1": "Initial", "2": "Routine", "3": "FieldChange"}},
        {"offset": 99, "width": 1, "field": "issuer_len", "type": "u8", "max": 64},
        {"offset": 100, "width": 1, "field": "approver_len", "type": "u8", "max": 64},
        {"offset": 101, "width": 2, "field": "reason_len", "type": "u16le", "max": 256}
      ],
      "variable_text_offset": 103,
      "variable_text_order": ["release", "facility", "change_ref", "issuer_principal_id", "approver_principal_id", "reason"],
      "components": ["airspace.snapshot"]
    },
    "3": {
      "fixed_header_bytes": 143,
      "issue_header_offset": 58,
      "issue_header_fields": "same as version 2 through offset 102",
      "ca_preset_fields": [
        {"offset": 103, "width": 8, "field": "ca_preset_len", "type": "u64le", "range": "1..=65536"},
        {"offset": 111, "width": 32, "field": "ca_preset_sha256", "type": "raw_sha256"}
      ],
      "variable_text_offset": 143,
      "variable_text_order": ["release", "facility", "change_ref", "issuer_principal_id", "approver_principal_id", "reason"],
      "components": ["airspace.snapshot", "ca-preset.oaca"]
    }
  },
  "validation": {
    "manifest_max_bytes": 1024,
    "no_trailing_bytes": true,
    "reader_range": "reader_min <= reader_max and reader_min <= 1 <= reader_max",
    "text_tokens": "nonempty ASCII alphanumeric or -_./; slash components cannot be empty, . or ..",
    "principal_ids": "nonempty ASCII alphanumeric or -_.; at most 64 bytes; issuer and approver differ",
    "reason": "1..=256 printable ASCII bytes",
    "initial_version_rule": "adaptation_version is 1 iff change_class is Initial",
    "canonical": "decoder re-encodes the parsed structure and rejects bytes that differ",
    "snapshot_binding": "component byte length and SHA-256 must match manifest; snapshot filename is airspace.snapshot",
    "ca_preset_binding": "v3 companion byte length and SHA-256 must match manifest; length is 1..=oa_ca::CA_PRESET_MAX_BYTES (65,536)",
    "component_inventory": "v1/v2 require exactly one component; v3 exactly two",
    "pin": "expected manifest SHA-256 is provisioned separately; package bytes do not self-authenticate",
    "authenticity": "SHA-256 provides integrity/equality only; it does not authenticate issuer, approver, or principal claims"
  },
  "portability_drill_reader": {
    "implementation": "../../../tools/j2_portability.py::validate_adaptation_package",
    "supported_versions": [1],
    "refused_versions": [2, 3],
    "reason": "the existing J2 portability bundle reader intentionally accepts only v1; this does not change the OA-G2 package reader's v1-v3 support"
  },
  "synthetic_test_reference": "./test_format_specs.py"
}
