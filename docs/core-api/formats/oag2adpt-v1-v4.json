  "validation": {
    "manifest_max_bytes": 1024,
    "no_trailing_bytes": true,
    "reader_range": "reader_min <= reader_max and reader_min <= 1 <= reader_max",
    "text_tokens": "nonempty ASCII alphanumeric or -_./; slash components cannot be empty, . or ..",
    "principal_ids": "nonempty ASCII alphanumeric or -_.; at most 64 bytes; issuer and approver differ",
    "reason": "1..=256 printable ASCII bytes",
    "initial_version_rule": "adaptation_version is 1 iff change_class is Initial",
    "canonical": "decoder re-encodes the parsed structure and rejects bytes that differ",
    "snapshot_binding": "component byte length and SHA-256 must match manifest; snapshot filename is airspace.snapshot",
    "ca_preset_binding": "v3 requires the ca-preset.oaca companion; v4 may include it. When present, exact companion byte length and SHA-256 must match manifest; length is 1..=oa_ca::CA_PRESET_MAX_BYTES (65,536).",
    "component_inventory": "v1/v2 require airspace.snapshot; v3 requires airspace.snapshot and ca-preset.oaca; v4 requires airspace.snapshot and pver-catalog.oapv, with optional ca-preset.oaca. manifest.oag2 is always present and is excluded from component_count. No extra package files are accepted.",
    "pin": "expected manifest SHA-256 is provisioned separately; package bytes do not self-authenticate",
    "authenticity": "SHA-256 provides integrity/equality only; it does not authenticate issuer, approver, or principal claims",
    "pver_catalog_binding": "v4 requires pver-catalog.oapv; exact companion byte length and SHA-256 must match manifest; length is 1..=16384. This reader checks byte binding only; oa-certification separately interprets the catalog schema.",
    "maximum_package_bytes": "snapshot max + 1024-byte manifest + 65,536-byte CA preset + 16,384-byte PVER catalog (optional companions count only when present); enforced across package files.",
    "reference_reader_scope": "The synthetic reader validates canonical manifest bytes, declared component lengths/digests, and exact package filenames. It does not decode the airspace snapshot, parse CA preset contents, or interpret the PVER catalog. Production OA-G2 verification decodes the snapshot and validates CA preset contents; oa-certification interprets the bound PVER catalog."
  },
